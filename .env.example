# FOMO Copy-Trading Bot Environment Variables
# Copy to .env and customize. NEVER commit real private keys or tokens to Git!

# Operational Mode ('paper' or 'live')
BOT_MODE=paper

# Live Trading Safeguard (Mandatory if BOT_MODE=live)
CONFIRM_LIVE_TRADING=false

# Dedicated Solana Trading Wallet (Base58 or JSON array format)
# WARNING: ONLY use a separate, dedicated wallet with disposable capital. NEVER use your main wallet!
SOLANA_PRIVATE_KEY=

# Solana RPC Endpoint (e.g. Helius, QuickNode, Triton, or public endpoint)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# StalkChain MCP API Key (Optional if using public tier)
STALKCHAIN_API_KEY=

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Render Web Service Port (Auto-injected by Render)
PORT=8080

# Emergency Kill Switch ('true' to pause copying immediately)
KILL_SWITCH=false
